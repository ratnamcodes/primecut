# PrimeCut web environment.
# This file is committed and must never contain a real value.
# Copy it to .env.local (git-ignored) and fill that in.

# --- PrimeCut API ---
# Base URL of the primecut api (e.g. http://localhost:8000). Inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=

# --- Clerk (auth, Phase 3) ---
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
