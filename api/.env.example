# PrimeCut API environment template (api/.env.example)
#
# This file is COMMITTED and must NEVER contain a real value. Copy it and fill
# in the copy, which is gitignored and stays on your machine:
#
#     cp .env.example .env
#
# Every key maps to a field on primecut.config.Settings (same name, lowercased).
# Leave a key empty to use the default from config.py; empty values count as
# unset. Variables already exported in your shell take precedence over this
# file. If a key ever leaks, ROTATE it in the provider's dashboard; deleting
# the line does nothing once it has been pushed.

# ----------------------------------------------------------------------------
# Required. Startup fails with a ConfigError until both are set.
# ----------------------------------------------------------------------------
# Google AI Studio -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Hugging Face read token -> https://huggingface.co/settings/tokens
# (also accept the pyannote model terms on the Hub so diarization can download)
HF_TOKEN=

# ----------------------------------------------------------------------------
# Cloudflare R2 object storage (Phase 2+)
# ----------------------------------------------------------------------------
# Account ID: https://dash.cloudflare.com -> R2 -> Overview (right sidebar)
R2_ACCOUNT_ID=
# Access keys: https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name. Default: primecut-media
R2_BUCKET=

# ----------------------------------------------------------------------------
# Upstash Redis (Phase 3) -> https://console.upstash.com -> database -> REST API
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# Dodo Payments (Phase 3) -> https://app.dodopayments.com -> Developer
# ----------------------------------------------------------------------------
# Developer -> API Keys
DODO_API_KEY=
# Developer -> Webhooks -> signing secret
DODO_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Clerk auth (Phase 3) -> https://dashboard.clerk.com -> API Keys
# ----------------------------------------------------------------------------
CLERK_SECRET_KEY=

# ----------------------------------------------------------------------------
# Infrastructure
# ----------------------------------------------------------------------------
# Name of the Modal secret that mirrors these keys on the GPU side.
# Default: primecut-secrets
MODAL_SECRET_NAME=
# SQLAlchemy URL for Postgres. The default matches docker-compose.yml:
# postgresql+psycopg://postgres:postgres@localhost:5432/primecut
DATABASE_URL=

# ----------------------------------------------------------------------------
# Tunables. Leave empty for the defaults shown; later tasks read these by name.
# ----------------------------------------------------------------------------
# Default: gemini-3.1-pro-preview
RANKING_MODEL=
# Default: gemini-3.5-flash
SUMMARY_MODEL=
# Default: large-v3-turbo
WHISPER_MODEL=
# Default: 20.0
MIN_CLIP_SECONDS=
# Default: 75.0
MAX_CLIP_SECONDS=
# Default: 6
DEFAULT_NUM_SHORTS=
# Default: 900 (15 minutes)
EPISODE_CUT_TARGET_SECONDS=
# Default: 0.18
CLIP_PAD_SECONDS=
# Default: 1080
TARGET_WIDTH=
# Default: 1920
TARGET_HEIGHT=
# Default: 30
TARGET_FPS=
# Default: 20
CRF=
# Default: medium
X264_PRESET=
# Default: 192k
AUDIO_BITRATE=
# Default: 1
CREDITS_PER_SOURCE_MINUTE=
